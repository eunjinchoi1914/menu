<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>오늘 점심 뭐 먹지? - 점심메뉴 돌림판</title>
  <style>
    :root {
      --primary-color: #0d9488;
      --primary-hover: #0f766e;
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-color: #1e293b;
      --border-color: #e2e8f0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      display: grid;
      grid-template-columns: 1fr;
      gap: 30px;
      max-width: 1000px;
      width: 100%;
      background: var(--card-bg);
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    @media (min-width: 768px) {
      .container {
        grid-template-columns: 1fr 1fr;
      }
    }

    .header {
      grid-column: 1 / -1;
      text-align: left;
    }

    .header h1 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .header p {
      color: #64748b;
      font-size: 0.95rem;
    }

    /* Wheel Section */
    .wheel-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .wheel-container {
      position: relative;
      width: 320px;
      height: 320px;
      margin-bottom: 20px;
    }

    .pointer {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 14px solid transparent;
      border-right: 14px solid transparent;
      border-top: 24px solid #ef4444;
      z-index: 10;
    }

    canvas {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .center-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 60px;
      background: white;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: bold;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      z-index: 5;
      font-size: 1.1rem;
    }

    .spin-btn {
      width: 80%;
      max-width: 250px;
      padding: 14px 0;
      background-color: var(--primary-color);
      color: white;
      border: none;
      border-radius: 30px;
      font-size: 1.2rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }

    .spin-btn:hover {
      background-color: var(--primary-hover);
    }

    .spin-btn:active {
      transform: scale(0.98);
    }

    .result-display {
      margin-top: 15px;
      font-size: 1.1rem;
      font-weight: 600;
      height: 28px;
      color: #0f172a;
    }

    /* Controls Section */
    .controls-section {
      background: #f8fafc;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    .section-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .count-control {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .count-btn {
      width: 32px;
      height: 32px;
      border: 1px solid var(--border-color);
      background: white;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }

    .count-btn:hover {
      background: #f1f5f9;
    }

    .menu-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 280px;
      overflow-y: auto;
      margin-bottom: 15px;
      padding-right: 4px;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .color-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .menu-input {
      flex: 1;
      padding: 8px 12px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font-size: 0.95rem;
      outline: none;
    }

    .menu-input:focus {
      border-color: var(--primary-color);
    }

    .remove-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 1.2rem;
      cursor: pointer;
      padding: 0 4px;
    }

    .remove-btn:hover {
      color: #ef4444;
    }

    .option-group {
      margin-bottom: 15px;
      font-size: 0.9rem;
      color: #475569;
    }

    .btn-group {
      display: flex;
      gap: 10px;
    }

    .sub-btn {
      flex: 1;
      padding: 8px 0;
      background: white;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font-size: 0.85rem;
      cursor: pointer;
      color: #334155;
    }

    .sub-btn:hover {
      background: #f1f5f9;
    }

    .footer-note {
      margin-top: 12px;
      font-size: 0.8rem;
      color: #94a3b8;
    }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>오늘 점심 뭐 먹지?</h1>
    <p>칸 수를 정하고 메뉴를 적은 뒤, 돌림판을 돌려 보세요.</p>
  </div>

  <!-- 돌림판 영역 -->
  <div class="wheel-section">
    <div class="wheel-container">
      <div class="pointer"></div>
      <canvas id="wheelCanvas" width="320" height="320"></canvas>
      <div class="center-btn">GO</div>
    </div>
    <button class="spin-btn" id="spinBtn">돌리기!</button>
    <div class="result-display" id="resultDisplay">결과가 여기에 나와요</div>
  </div>

  <!-- 설정 영역 -->
  <div class="controls-section">
    <div class="section-title">
      <span>메뉴 칸</span>
      <div class="count-control">
        <button class="count-btn" id="decBtn">−</button>
        <span id="countDisplay">6</span>
        <button class="count-btn" id="incBtn">+</button>
        <span style="font-size: 0.8rem; color: #64748b; font-weight: normal;">칸 (2~16)</span>
      </div>
    </div>

    <div class="menu-list" id="menuList"></div>

    <div class="option-group">
      <label>
        <input type="checkbox" id="removeWonOption"> 나온 메뉴는 다음 판에서 빼기
      </label>
    </div>

    <div class="btn-group">
      <button class="sub-btn" id="fillPresetBtn">예시 메뉴로 채우기</button>
      <button class="sub-btn" id="clearAllBtn">모두 지우기</button>
    </div>

    <div class="footer-note">
      빈 칸은 돌림판에 나오지 않아요. 적은 메뉴는 이 기기에 저장돼요.
    </div>
  </div>
</div>

<script>
  const COLORS = [
    '#ef4444', '#f97316', '#f59e0b', '#10b981', '#06b6d4', 
    '#3b82f6', '#6366f1', '#8b5cf6', '#ec4899', '#f43f5e',
    '#84cc16', '#14b8a6', '#0284c7', '#a855f7', '#d946ef', '#64748b'
  ];

  const PRESET_MENUS = ['김치찌개', '돈가스', '비빔밥', '짜장면', '떡볶이', '칼국수'];

  let menus = JSON.parse(localStorage.getItem('lunch_menus')) || [...PRESET_MENUS];
  let isSpinning = false;
  let currentRotation = 0;

  const canvas = document.getElementById('wheelCanvas');
  const ctx = canvas.getContext('2d');
  const menuListEl = document.getElementById('menuList');
  const countDisplay = document.getElementById('countDisplay');
  const resultDisplay = document.getElementById('resultDisplay');

  // 초기화 함수
  function init() {
    renderMenuList();
    drawWheel();
  }

  // 메뉴 리스트 UI 그리기
  function renderMenuList() {
    menuListEl.innerHTML = '';
    countDisplay.textContent = menus.length;

    menus.forEach((menu, index) => {
      const item = document.createElement('div');
      item.className = 'menu-item';

      const colorDot = document.createElement('div');
      colorDot.className = 'color-dot';
      colorDot.style.backgroundColor = COLORS[index % COLORS.length];

      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'menu-input';
      input.value = menu;
      input.placeholder = `${index + 1}. 메뉴 입력`;
      input.oninput = (e) => {
        menus[index] = e.target.value;
        saveAndRedraw();
      };

      const removeBtn = document.createElement('button');
      removeBtn.className = 'remove-btn';
      removeBtn.innerHTML = '×';
      removeBtn.onclick = () => removeMenu(index);

      item.appendChild(colorDot);
      item.appendChild(input);
      item.appendChild(removeBtn);
      menuListEl.appendChild(item);
    });
  }

  // 돌림판 Canvas 그리기
  function drawWheel() {
    const activeMenus = menus.filter(m => m.trim() !== '');
    const total = activeMenus.length || 1;
    const arc = (2 * Math.PI) / total;
    const radius = canvas.width / 2;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (activeMenus.length === 0) {
      ctx.beginPath();
      ctx.arc(radius, radius, radius, 0, 2 * Math.PI);
      ctx.fillStyle = '#e2e8f0';
      ctx.fill();
      return;
    }

    activeMenus.forEach((menu, i) => {
      const angle = i * arc;
      ctx.beginPath();
      ctx.fillStyle = COLORS[i % COLORS.length];
      ctx.moveTo(radius, radius);
      ctx.arc(radius, radius, radius, angle, angle + arc);
      ctx.lineTo(radius, radius);
      ctx.fill();

      // 텍스트 그리기
      ctx.save();
      ctx.translate(radius, radius);
      ctx.rotate(angle + arc / 2);
      ctx.textAlign = 'right';
      ctx.fillStyle = 'white';
      ctx.font = 'bold 16px sans-serif';
      ctx.fillText(menu, radius - 20, 6);
      ctx.restore();
    });
  }

  // 변경사항 저장 및 다시 그리기
  function saveAndRedraw() {
    localStorage.setItem('lunch_menus', JSON.stringify(menus));
    drawWheel();
  }

  // 돌리기 로직
  document.getElementById('spinBtn').onclick = () => {
    const validMenus = menus.filter(m => m.trim() !== '');
    if (validMenus.length < 2) {
      alert('최소 2개 이상의 메뉴를 입력해주세요!');
      return;
    }
    if (isSpinning) return;

    isSpinning = true;
    resultDisplay.textContent = '두구두구...';

    const spinAngle = Math.floor(Math.random() * 360) + 1440; // 최소 4바퀴 회전
    currentRotation += spinAngle;

    canvas.style.transition = 'transform 4s cubic-bezier(0.15, 0.99, 0.18, 0.99)';
    canvas.style.transform = `rotate(${currentRotation}deg)`;

    setTimeout(() => {
      isSpinning = false;
      const actualDegrees = currentRotation % 360;
      const arcSize = 360 / validMenus.length;
      
      // 화살표가 상단(270도 위치)을 가리키므로 계산 조정
      const selectedIndex = Math.floor((360 - (actualDegrees % 360) + 270) % 360 / arcSize);
      const wonMenu = validMenus[selectedIndex];

      resultDisplay.innerHTML = `🎉 오늘 점심은 <strong>${wonMenu}</strong>!`;

      // 당첨 메뉴 삭제 옵션 체크 시
      if (document.getElementById('removeWonOption').checked) {
        const idxInMain = menus.indexOf(wonMenu);
        if (idxInMain > -1) {
          setTimeout(() => removeMenu(idxInMain), 1500);
        }
      }
    }, 4000);
  };

  // 칸 수 조절
  document.getElementById('incBtn').onclick = () => {
    if (menus.length < 16) {
      menus.push('');
      renderMenuList();
      saveAndRedraw();
    }
  };

  document.getElementById('decBtn').onclick = () => {
    if (menus.length > 2) {
      menus.pop();
      renderMenuList();
      saveAndRedraw();
    }
  };

  function removeMenu(index) {
    if (menus.length > 2) {
      menus.splice(index, 1);
      renderMenuList();
      saveAndRedraw();
    } else {
      alert('최소 2개의 칸은 유지되어야 합니다.');
    }
  }

  document.getElementById('clearAllBtn').onclick = () => {
    menus = menus.map(() => '');
    renderMenuList();
    saveAndRedraw();
  };

  document.getElementById('fillPresetBtn').onclick = () => {
    menus = [...PRESET_MENUS];
    renderMenuList();
    saveAndRedraw();
  };

  init();
</script>
</body>
</html>